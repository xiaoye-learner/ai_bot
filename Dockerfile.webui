FROM xxxxrt666/gpt-sovits:latest-cu128

# 设置工作目录
WORKDIR /app

# 复制依赖文件
COPY requirements_webui.txt .

RUN pip config set global.index-url https://pypi.tuna.tsinghua.edu.cn/simple

# 安装 WebUI 需要的库
RUN pip install --no-cache-dir --ignore-installed -r requirements_webui.txt

# 解决编码问题
ENV PYTHONIOENCODING=utf-8

# 复制当前代码
COPY . .

# 暴露端口
EXPOSE 7860

# 启动
CMD ["python", "webui.py"]